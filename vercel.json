{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/prices.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/announcements/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/results/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/seed/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
