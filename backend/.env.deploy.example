# Production settings for the FINN backend on a free-tier host. Copy to the host's environment variables (never commit real values).
# The goal: finish a new analysis reliably and cheaply, and make it impossible for strangers to spend your Gemini key.

GEMINI_API_KEY=            # set in the host's secret store only

# Gemini's larger models were overloaded (503 / timeouts) during testing. The cheap Flash-Lite model answered every time,
# so deploy with it as the Stage-2 model: the run completes instead of waiting minutes on a model that may not respond.
STRONG_MODEL=gemini-3.5-flash-lite
CHEAP_MODEL=gemini-3.5-flash-lite
STRONG_MODEL_FALLBACKS=
# Fail fast: one retry per model and a 60s request timeout, so a stuck call cannot hold the single worker for 10+ minutes.
STRONG_RETRIES=1
LLM_TIMEOUT=60

# Spend protection: at most this many NEW analyses per UTC day; existing/seed research is always free to view.
MAX_NEW_ANALYSES_PER_DAY=3
# New analyses and re-runs require this code in the X-Access-Code header. Without it, re-runs are disabled entirely.
ACCESS_CODE=change-me-to-a-long-random-string
# Only your deployed frontend may call the API (comma-separated, no trailing slashes).
ALLOWED_ORIGINS=https://your-frontend.example.com
